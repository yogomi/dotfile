#!/bin/bash
#
# gitリポジトリ内でclaudeを起動する際、プロジェクトルート名をセッション名として使う。
# 直近のセッションがTHRESHOLD_HOURS時間以内なら公式の --continue で再開し、それ以外は
# セッション名を付けて新規に起動する。
#
# resume判定は $CLAUDE_CONFIG_DIR/projects/ 配下にある当該プロジェクトの
# transcript（*.jsonl）の最終更新時刻で行う。かつて使っていた自前の状態ファイル
# （project-sessions/）と要約生成・注入（claude-session-summary + SessionStart/SessionEnd
# フック）は廃止した。セッションをまたぐ文脈の引き継ぎは公式のauto-memoryに任せる。
#
# --solo を付けるとgitリポジトリ内でもプロジェクトに紐付けず、素のclaudeとして起動する。
# --solo 以外の引数はclaudeへそのまま渡す。

SOLO=""
ARGS=()
for arg in "$@"; do
  if [ "$arg" = "--solo" ]; then
    SOLO=1
  else
    ARGS+=("$arg")
  fi
done

if [ -n "$SOLO" ]; then
  exec claude "${ARGS[@]}"
fi

GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)

if [ -z "$GIT_ROOT" ]; then
  exec claude "${ARGS[@]}"
fi

SESSION_NAME=$(basename "$GIT_ROOT")
PROJECT_KEY=$(echo "$GIT_ROOT" | sed 's/[^a-zA-Z0-9]/-/g')
CONF_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
THRESHOLD_HOURS=5

cd "$GIT_ROOT" || exec claude "${ARGS[@]}"

# 当該プロジェクトの最新transcriptが閾値以内に更新されていれば --continue で再開する。
# find -mmin はBSD/GNU両対応のため、mtime判定はstatではなくfindで行う
PROJECT_DIR="$CONF_DIR/projects/$PROJECT_KEY"
THRESHOLD_MINS=$((THRESHOLD_HOURS * 60))
RECENT=$(find "$PROJECT_DIR" -maxdepth 1 -name '*.jsonl' -mmin -"$THRESHOLD_MINS" 2>/dev/null \
  | head -n 1)

if [ -n "$RECENT" ]; then
  exec claude --continue "${ARGS[@]}"
fi

exec claude --name "$SESSION_NAME" "${ARGS[@]}"
