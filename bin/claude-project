#!/bin/bash
#
# gitリポジトリ内でclaudeを起動する際、プロジェクトルート名をセッション名として使う。
# 直近のセッションがTHRESHOLD_HOURS時間以内なら公式の --continue で再開し、それ以外は
# 要約を生成してから新規セッションを開始する。
#
# 再開の実体は公式機能（--continue / Agent View）に任せる。このスクリプトが担うのは
# gitルートへの正規化・プロジェクト名の命名・古いセッションの要約注入のみで、
# session_idの追跡や稼働中セッションの検出は行わない。
#
# セッションの状態（transcript_path, ended_at）は $HOME/.claude/project-sessions/ 配下の
# 自前ファイルで管理する。projectsディレクトリとは異なり、個人用・仕事用の
# CLAUDE_CONFIG_DIRに関わらず共通の場所を使う（どちらのプロファイルで起動しても同じ
# 状態を参照できるようにするため）。transcript（*.jsonl）は読み取るだけで、
# 書き込み・書き換えは一切行わない。
#
# --solo を付けるとgitリポジトリ内でもプロジェクトに紐付けず、resume・要約注入・
# セッション名なしの独立したセッションとして起動する。--solo 以外の引数はclaudeへ
# そのまま渡す。

SOLO=""
ARGS=()
for arg in "$@"; do
  if [ "$arg" = "--solo" ]; then
    SOLO=1
  else
    ARGS+=("$arg")
  fi
done

if [ -n "$SOLO" ]; then
  # SessionStart/SessionEndフックがこの環境変数を見て、要約注入と状態記録をスキップする
  export CLAUDE_PROJECT_SOLO=1
  exec claude "${ARGS[@]}"
fi

GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)

if [ -z "$GIT_ROOT" ]; then
  exec claude "${ARGS[@]}"
fi

SESSION_NAME=$(basename "$GIT_ROOT")
PROJECT_KEY=$(echo "$GIT_ROOT" | sed 's/[^a-zA-Z0-9]/-/g')
CONF_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
THRESHOLD_HOURS=5

cd "$GIT_ROOT" || exec claude "${ARGS[@]}"

STATE_DIR="$HOME/.claude/project-sessions"
STATE_FILE="$STATE_DIR/${PROJECT_KEY}.json"
SUMMARY_FILE="$STATE_DIR/${PROJECT_KEY}.summary.md"
PENDING_FILE="$STATE_DIR/${PROJECT_KEY}.pending.md"

mkdir -p "$STATE_DIR"

TRANSCRIPT=""
ENDED_AT=0

if [ -f "$STATE_FILE" ]; then
  STATE_INFO=$(STATE_FILE="$STATE_FILE" python3 - <<'EOF'
import json, os

# 状態ファイルが破損していても起動を止めない（空扱いにしてフォールバックへ）
try:
    with open(os.environ['STATE_FILE']) as f:
        d = json.load(f)
except Exception:
    d = {}

print(d.get('transcript_path') or '')
print(d.get('ended_at') or 0)
EOF
)
  TRANSCRIPT=$(echo "$STATE_INFO" | sed -n '1p')
  ENDED_AT=$(echo "$STATE_INFO" | sed -n '2p')
fi

# 前回セッションの記録がなければ、プロジェクト名を付けて新規起動する
if [ -z "$TRANSCRIPT" ]; then
  exec claude --name "$SESSION_NAME" "${ARGS[@]}"
fi

# --continue は現在のCLAUDE_CONFIG_DIR内のセッションしか探せない。状態ファイルは
# プロファイル間で共有されるため、transcriptが現在のプロファイルのprojects/配下に
# 実在する場合のみ再開可能と判定する。それ以外（別プロファイルのセッション）は
# 要約を生成して新規セッションを開始する
RESUMABLE=""
if [ -f "$TRANSCRIPT" ]; then
  case "$TRANSCRIPT" in
    "$CONF_DIR/projects/"*) RESUMABLE=1 ;;
  esac
else
  # transcriptは要約の入力にも使うため、実在しない場合はクリアして要約をスキップする
  TRANSCRIPT=""
fi

NOW_EPOCH=$(date +%s)
ELAPSED=$((NOW_EPOCH - ENDED_AT))
THRESHOLD_SECS=$((THRESHOLD_HOURS * 3600))

# 閾値内なら、このディレクトリの直近セッションを公式の --continue で再開する
if [ -n "$RESUMABLE" ] && [ "$ELAPSED" -le "$THRESHOLD_SECS" ]; then
  exec claude --continue "${ARGS[@]}"
fi

# 閾値超過またはresume不可：要約を生成してからセッション名を再利用して新規起動する
# （要約生成はtranscriptを直接読むだけなので別プロファイルのものでもよい。失敗しても続行）
if [ -n "$TRANSCRIPT" ]; then
  ~/bin/claude-session-summary "$TRANSCRIPT" "$SUMMARY_FILE" "$PENDING_FILE"
fi

exec claude --name "$SESSION_NAME" "${ARGS[@]}"
