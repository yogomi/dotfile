#!/bin/bash
#
# 指定されたセッションの最終メッセージから THRESHOLD_HOURS 以上経過していた場合、
# 会話内容を要約してセッションをコンパクト化する。
# 元のセッションファイルは $CONF_DIR/session-archive/ にバックアップする。
#
# Usage: claude-session-compact <session_file> <session_name> <conf_dir> [threshold_hours]

SESSION_FILE="$1"
SESSION_NAME="$2"
CONF_DIR="$3"
THRESHOLD_HOURS="${4:-5}"

[ -z "$SESSION_FILE" ] || [ ! -f "$SESSION_FILE" ] && exit 0

THRESHOLD_SECS=$((THRESHOLD_HOURS * 3600))
NOW_EPOCH=$(date +%s)

# 最終タイムスタンプを取得
LAST_EPOCH=$(SESSION_FILE="$SESSION_FILE" python3 - <<'EOF'
import json, sys, os
from datetime import datetime, timezone

with open(os.environ['SESSION_FILE']) as f:
    lines = f.readlines()

for line in reversed(lines):
    line = line.strip()
    if not line:
        continue
    try:
        d = json.loads(line)
        ts = d.get('timestamp')
        if ts:
            dt = datetime.fromisoformat(ts.replace('Z', '+00:00'))
            print(int(dt.timestamp()))
            sys.exit(0)
    except Exception:
        pass
print(0)
EOF
)

ELAPSED=$((NOW_EPOCH - LAST_EPOCH))
[ "$ELAPSED" -le "$THRESHOLD_SECS" ] && exit 0

ELAPSED_HOURS=$((ELAPSED / 3600))
echo "[claude-session-compact] 前回のセッションから ${ELAPSED_HOURS} 時間経過。要約を生成中..." >&2

# 会話テキストを抽出し、20件ずつのチャンクファイルに分割して出力
# 末尾優先で最大120件、各メッセージ1500文字まで
CHUNK_DIR=$(mktemp -d)

SESSION_FILE="$SESSION_FILE" CHUNK_DIR="$CHUNK_DIR" python3 - <<'EOF'
import json, sys, os

with open(os.environ['SESSION_FILE']) as f:
    lines = f.readlines()

messages = []
for line in lines:
    line = line.strip()
    if not line:
        continue
    try:
        d = json.loads(line)
        if d.get('type') not in ('user', 'assistant'):
            continue
        msg = d.get('message', {})
        role = msg.get('role', d['type'])
        content = msg.get('content', '')
        if isinstance(content, list):
            text = ' '.join(
                c.get('text', '') for c in content
                if isinstance(c, dict) and c.get('type') == 'text'
            )
        else:
            text = str(content)
        text = text.strip()
        if len(text) < 10:
            continue
        messages.append(f'[{role}]: {text[:1500]}')
    except Exception:
        pass

selected = messages[-120:] if len(messages) > 120 else messages

chunk_dir = os.environ['CHUNK_DIR']
chunks = [selected[i:i+20] for i in range(0, len(selected), 20)]
for i, chunk in enumerate(chunks):
    with open(f'{chunk_dir}/chunk_{i:03d}.txt', 'w') as f:
        f.write('\n\n'.join(chunk))
EOF

CHUNK_COUNT=$(ls "$CHUNK_DIR"/chunk_*.txt 2>/dev/null | wc -l | tr -d ' ')

if [ "$CHUNK_COUNT" -eq 0 ]; then
  echo "[claude-session-compact] 会話内容が見つかりませんでした。スキップします。" >&2
  rm -rf "$CHUNK_DIR"
  exit 0
fi

# Map フェーズ：各チャンクを個別に要約
CHUNK_SUMMARIES=""
CHUNK_NUM=0

for chunk_file in "$CHUNK_DIR"/chunk_*.txt; do
    CHUNK_NUM=$((CHUNK_NUM + 1))
    echo "[claude-session-compact] チャンク ${CHUNK_NUM}/${CHUNK_COUNT} を要約中..." >&2
    chunk_summary=$(cat "$chunk_file" | claude -p \
        "以下の会話の一部を日本語で要約してください（500字以内）。決定事項・重要な情報・コードや設定の具体的な内容を含めてください。余計な前置きは不要です。" \
        2>/dev/null)
    if [ -n "$chunk_summary" ]; then
        CHUNK_SUMMARIES="${CHUNK_SUMMARIES}

--- チャンク${CHUNK_NUM} ---
${chunk_summary}"
    fi
done

rm -rf "$CHUNK_DIR"

if [ -z "$CHUNK_SUMMARIES" ]; then
  echo "[claude-session-compact] チャンク要約の生成に失敗しました。セッションをそのまま使用します。" >&2
  exit 0
fi

# Reduce フェーズ：チャンク要約を統合して最終要約を生成
echo "[claude-session-compact] 最終要約を生成中..." >&2
SUMMARY=$(echo "$CHUNK_SUMMARIES" | claude -p \
  "以下は会話を分割して要約したものです。これらを統合し、以下の形式で最終要約を作成してください（3000字以内）。余計な前置きは不要です。

## 作業概要
（何をしていたか）

## 決定事項・方針
（重要な決定や採用した方針）

## 重要なコード・設定
（コードや設定の具体的な詳細）

## 未完了タスク
（まだ終わっていること）" \
  2>/dev/null)

if [ -z "$SUMMARY" ]; then
  echo "[claude-session-compact] 要約の生成に失敗しました。セッションをそのまま使用します。" >&2
  exit 0
fi

# バックアップ
ARCHIVE_DIR="$CONF_DIR/session-archive"
mkdir -p "$ARCHIVE_DIR"
BACKUP_FILE="$ARCHIVE_DIR/$(basename "${SESSION_FILE%.jsonl}")_$(date +%Y%m%d_%H%M%S).jsonl"
cp "$SESSION_FILE" "$BACKUP_FILE"

# コンパクト化した新しいJSONLを書き込む
SESSION_FILE="$SESSION_FILE" SESSION_NAME="$SESSION_NAME" SUMMARY="$SUMMARY" python3 - <<'EOF'
import json, sys, os
from datetime import datetime, timezone

session_file = os.environ['SESSION_FILE']
session_name = os.environ['SESSION_NAME']
summary      = os.environ['SUMMARY']
now          = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%S.000Z')

session_id = None
with open(session_file) as f:
    for line in f:
        try:
            d = json.loads(line)
            if 'sessionId' in d:
                session_id = d['sessionId']
                break
        except Exception:
            pass

if not session_id:
    import uuid
    session_id = str(uuid.uuid4())

lines = [
    json.dumps({'type': 'custom-title', 'customTitle': session_name, 'sessionId': session_id}, ensure_ascii=False),
    json.dumps({'type': 'agent-name',   'agentName':   session_name, 'sessionId': session_id}, ensure_ascii=False),
    json.dumps({
        'type': 'user',
        'sessionId': session_id,
        'timestamp': now,
        'message': {
            'role': 'user',
            'content': f'[前のセッションの要約]\n\n{summary}',
        },
    }, ensure_ascii=False),
    json.dumps({
        'type': 'assistant',
        'sessionId': session_id,
        'timestamp': now,
        'message': {
            'role': 'assistant',
            'content': [{'type': 'text', 'text': '了解しました。前のセッションの内容を踏まえて続けます。'}],
        },
    }, ensure_ascii=False),
]

with open(session_file, 'w') as f:
    f.write('\n'.join(lines) + '\n')
EOF

echo "[claude-session-compact] 要約完了。バックアップ: $BACKUP_FILE" >&2
echo ""
echo "--- 生成された要約 ---"
echo "$SUMMARY"
echo "----------------------"
