#!/bin/bash
#
# セッションのtranscriptを要約し、要約ファイルと注入待ちファイルを更新する。
# bin/claude-session-compact の後継。transcript（.jsonl）は読み取るだけで、
# 書き込み・書き換えは一切行わない（旧版はコンパクト化したJSONLで元ファイルを
# 上書きしていたが、それをやめて自前の状態ファイルに要約を切り出す方式にした）。
#
# Usage: claude-session-summary <session_file> <summary_file> <pending_file>

SESSION_FILE="$1"
SUMMARY_FILE="$2"
PENDING_FILE="$3"

[ -z "$SESSION_FILE" ] || [ ! -f "$SESSION_FILE" ] && exit 0
[ -z "$SUMMARY_FILE" ] || [ -z "$PENDING_FILE" ] && exit 0

echo "[claude-session-summary] 要約を生成中..." >&2

# 会話テキストを抽出し、20件ずつのチャンクファイルに分割して出力
# 末尾優先で最大120件、各メッセージ1500文字まで
CHUNK_DIR=$(mktemp -d)

SESSION_FILE="$SESSION_FILE" CHUNK_DIR="$CHUNK_DIR" python3 - <<'EOF'
import json, sys, os

with open(os.environ['SESSION_FILE']) as f:
    lines = f.readlines()

messages = []
for line in lines:
    line = line.strip()
    if not line:
        continue
    try:
        d = json.loads(line)
        if d.get('type') not in ('user', 'assistant'):
            continue
        msg = d.get('message', {})
        role = msg.get('role', d['type'])
        content = msg.get('content', '')
        if isinstance(content, list):
            text = ' '.join(
                c.get('text', '') for c in content
                if isinstance(c, dict) and c.get('type') == 'text'
            )
        else:
            text = str(content)
        text = text.strip()
        if len(text) < 10:
            continue
        messages.append(f'[{role}]: {text[:1500]}')
    except Exception:
        pass

selected = messages[-120:] if len(messages) > 120 else messages

chunk_dir = os.environ['CHUNK_DIR']
chunks = [selected[i:i+20] for i in range(0, len(selected), 20)]
for i, chunk in enumerate(chunks):
    with open(f'{chunk_dir}/chunk_{i:03d}.txt', 'w') as f:
        f.write('\n\n'.join(chunk))
EOF

CHUNK_COUNT=$(ls "$CHUNK_DIR"/chunk_*.txt 2>/dev/null | wc -l | tr -d ' ')

if [ "$CHUNK_COUNT" -eq 0 ]; then
  echo "[claude-session-summary] 会話内容が見つかりませんでした。スキップします。" >&2
  rm -rf "$CHUNK_DIR"
  exit 0
fi

# Map フェーズ：各チャンクを個別に要約
# claude -p はリポジトリ外（$HOME）で実行する。cwdがリポジトリ内だと要約用セッションの
# transcriptがそのリポジトリのprojectsディレクトリに作られてしまい、claude-projectの
# mtimeフォールバック（最新jsonlの探索）を汚染するため。
CHUNK_SUMMARIES=""
CHUNK_NUM=0

for chunk_file in "$CHUNK_DIR"/chunk_*.txt; do
    CHUNK_NUM=$((CHUNK_NUM + 1))
    echo "[claude-session-summary] チャンク ${CHUNK_NUM}/${CHUNK_COUNT} を要約中..." >&2
    chunk_summary=$(cat "$chunk_file" | (cd "$HOME" && claude -p --model sonnet \
        "以下の会話の一部を日本語で要約してください（500字以内）。決定事項・重要な情報・コードや設定の具体的な内容を含めてください。余計な前置きは不要です。" \
        2>/dev/null))
    if [ -n "$chunk_summary" ]; then
        CHUNK_SUMMARIES="${CHUNK_SUMMARIES}

--- チャンク${CHUNK_NUM} ---
${chunk_summary}"
    fi
done

rm -rf "$CHUNK_DIR"

if [ -z "$CHUNK_SUMMARIES" ]; then
  echo "[claude-session-summary] チャンク要約の生成に失敗しました。スキップします。" >&2
  exit 0
fi

# Reduce フェーズ：前回までの要約（あれば）とチャンク要約を統合して最終要約を生成する
REDUCE_INPUT="$CHUNK_SUMMARIES"
if [ -s "$SUMMARY_FILE" ]; then
  PREV_SUMMARY=$(cat "$SUMMARY_FILE")
  REDUCE_INPUT="--- 前回までの要約 ---
${PREV_SUMMARY}
${REDUCE_INPUT}"
fi

echo "[claude-session-summary] 最終要約を生成中..." >&2
SUMMARY=$(echo "$REDUCE_INPUT" | (cd "$HOME" && claude -p --model sonnet \
  "以下は前回までの要約と、今回の会話を分割して要約したものです。これらを統合し、
以下の形式で最終要約を作成してください（3000字以内）。余計な前置きは不要です。

## 作業概要
（何をしていたか）

## 決定事項・方針
（重要な決定や採用した方針）

## 重要なコード・設定
（コードや設定の具体的な詳細）

## 未完了タスク
（まだ終わっていること）" \
  2>/dev/null))

if [ -z "$SUMMARY" ]; then
  echo "[claude-session-summary] 要約の生成に失敗しました。スキップします。" >&2
  exit 0
fi

mkdir -p "$(dirname "$SUMMARY_FILE")"
printf '%s\n' "$SUMMARY" > "$SUMMARY_FILE"
printf '%s\n' "$SUMMARY" > "$PENDING_FILE"

echo "[claude-session-summary] 要約完了。$SUMMARY_FILE / $PENDING_FILE に保存しました。" >&2
echo ""
echo "--- 生成された要約 ---"
echo "$SUMMARY"
echo "----------------------"
