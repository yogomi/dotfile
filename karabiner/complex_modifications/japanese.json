{
  "title": "For Japanese",
  "rules": [
    {
      "description": "toggle japanese with shift + space",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": { "mandatory": "control" }
          },
          "conditions": [
            {
              "type": "input_source_if",
              "input_sources": [
                { "language": "en" },
                { "language": "uk" }
              ]
            }
          ],
          "to": [{ "key_code": "japanese_kana" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": { "mandatory": "control" }
          },
          "conditions": [
            {
              "type": "input_source_if",
              "input_sources": [
                { "language": "ja" },
                { "language": "uk" }
              ]
            }
          ],
          "to": [{ "key_code": "japanese_eisuu" }]
        }
      ]
    }
  ]
}
